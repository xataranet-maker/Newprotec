# Vercel KV / Upstash Redis Database Configuration
# Đặt các thông tin cấu hình này trong Project Settings > Environment Variables trên Vercel
# hoặc trong file .env.local khi chạy cục bộ.

KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your_token_here

# Hỗ trợ thêm cho Upstash Redis trực tiếp
UPSTASH_REDIS_REST_URL=https://your-kv-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
